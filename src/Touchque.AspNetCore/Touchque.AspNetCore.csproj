<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Touchque.AspNetCore</PackageId>
    <AssemblyName>Touchque.AspNetCore</AssemblyName>
    <RootNamespace>Touchque.AspNetCore</RootNamespace>
    <Description>ASP.NET Core integration for Touchque: AddTouchque() registration, RequireTouchque() on endpoints and controllers, the relay endpoints @touchque/web needs, verified webhooks, Touchque Login sign-in endpoints and a bearer handler for access tokens.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Touchque/Touchque.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../CHANGELOG.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Touchque.Tests" />
  </ItemGroup>

  <!-- This package uses Touchque's internals, so its package depends on exactly the same
       Touchque version ([5.0.0], not >= 5.0.0). -->
  <Target Name="PinTouchqueDependency" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions>
        <ProjectVersion>[%(_ProjectReferencesWithVersions.ProjectVersion)]</ProjectVersion>
      </_ProjectReferencesWithVersions>
    </ItemGroup>
  </Target>

</Project>
