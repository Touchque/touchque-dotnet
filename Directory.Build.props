<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>4.2.0</Version>
    <Authors>TouchQue</Authors>
    <Company>TouchQue</Company>
    <Copyright>Copyright (c) 2026 TouchQue</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://touchque.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Touchque/touchque-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>touchque;2fa;mfa;passkey;webauthn;authentication;push;ciam</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
