<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>5.1.0</Version>
    <Authors>Touchque</Authors>
    <Company>Touchque</Company>
    <Copyright>Copyright (c) 2026 Touchque</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://touchque.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Touchque/touchque-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>touchque;2fa;mfa;passkey;webauthn;authentication;push;ciam</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <!-- Release builds map source paths to /_/, so a package never carries the build machine's paths. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
